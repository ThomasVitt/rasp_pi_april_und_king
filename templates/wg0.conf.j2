[Interface]
Address = {{ wg_address }}
PrivateKey = {{ wg_private_key }}
{% if wg_lan_forwarding | bool %}
# Tunnel -> LAN {{ wg_lan_network }} weiterleiten und per NAT als Pi-Adresse ins LAN ausgeben
PostUp = iptables -I FORWARD 1 -i %i -o {{ wg_lan_interface }} -d {{ wg_lan_network }} -j ACCEPT
PostUp = iptables -I FORWARD 1 -i {{ wg_lan_interface }} -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -s {{ wg_tunnel_network }} -d {{ wg_lan_network }} -o {{ wg_lan_interface }} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -o {{ wg_lan_interface }} -d {{ wg_lan_network }} -j ACCEPT
PostDown = iptables -D FORWARD -i {{ wg_lan_interface }} -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -s {{ wg_tunnel_network }} -d {{ wg_lan_network }} -o {{ wg_lan_interface }} -j MASQUERADE
{% endif %}

[Peer]
# vServer
PublicKey = {{ wg_server_public_key }}
Endpoint = {{ wg_server_endpoint }}
AllowedIPs = {{ wg_allowed_ips }}
# haelt den Tunnel hinter NAT/Router dauerhaft offen
PersistentKeepalive = 25
